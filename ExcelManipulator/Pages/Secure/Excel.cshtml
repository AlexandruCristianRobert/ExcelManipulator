@page
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "ExcelWorker")]
@model ExcelModel
@{
    ViewData["Title"] = "Excel Upload";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <h2 class="mb-4 text-center">Upload Excel File</h2>

            <form method="post" enctype="multipart/form-data" class="needs-validation" novalidate>
                <div asp-validation-summary="All" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="File" class="form-label">Choose .xlsx or .xls file</label>
                    <input asp-for="File" class="form-control" accept=".xlsx,.xls" />
                    <span asp-validation-for="File" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100">Upload</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}