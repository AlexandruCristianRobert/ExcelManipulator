@model ExcelManipulator.Pages.Admin.UsersModel

<div class="modal fade" id="rolesModal" tabindex="-1" aria-labelledby="rolesModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="rolesModalLabel">Edit Roles</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page="/Admin/Users" asp-page-handler="UpdateRoles">
                <div class="modal-body">
                    <input type="hidden" asp-for="UpdateRolesInput.UserId" />
                    <div class="mb-3">
                        <label class="form-label">User Email</label>
                        <input type="text" class="form-control" asp-for="UpdateRolesInput.Email" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Roles</label>
                        <select asp-for="UpdateRolesInput.SelectedRoles" asp-items="Model.RoleSelectList" class="form-select" multiple size="@Model.RoleSelectList.Count"></select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>